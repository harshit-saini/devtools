# Configuration for the peer-to-peer tools (/meet, /file-share, /live-notepad).
# Copy to .env.local and adjust. Every NEXT_PUBLIC_ value is inlined into the browser bundle at
# build time, so none of them may hold a secret.

# WebSocket URL of the companion signaling server (https://github.com/harshit-saini/peer-server).
# The server only relays SDP and ICE; no media, file, or document data passes through it.
# A page served over HTTPS cannot open a ws:// socket, so use wss:// wherever the app is not on
# localhost.
NEXT_PUBLIC_PEER_SERVER_URL=ws://localhost:8080

# STUN servers used to discover a route between peers. Comma separated.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN relay. STUN alone cannot connect peers behind symmetric NAT or restrictive
# corporate firewalls; those connections simply fail, and the tools say so. Supplying a TURN
# server is what fixes them.
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Canonical site URL used for metadata and share links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
